      "defaultValue": "disk"
    },
    {
      "name": "tj.powerjob.worker.max-result-length",
      "type": "java.lang.Integer",
      "description": "任务返回结果最大长度，超过将被截断",
      "sourceType": "com.example.tj_project_apicommon.autoconfigure.powerjob.PowerJobProperties",
      "defaultValue": 8192
    },
    {
      "name": "tj.powerjob.worker.max-appended-wf-context-length",
      "type": "java.lang.Integer",
      "description": "工作流上下文最大长度，超过将被丢弃",
      "sourceType": "com.example.tj_project_apicommon.autoconfigure.powerjob.PowerJobProperties",
      "defaultValue": 8192
    },
    {
      "name": "tj.powerjob.worker.max-lightweight-task-num",
      "type": "java.lang.Integer",
      "description": "同时运行的轻量级任务数量上限",
      "sourceType": "com.example.tj_project_apicommon.autoconfigure.powerjob.PowerJobProperties",
      "defaultValue": 1024
    },
    {
      "name": "tj.powerjob.worker.max-heavy-task-num",
      "type": "java.lang.Integer",
      "description": "同时运行的重量级任务数量上限",
      "sourceType": "com.example.tj_project_apicommon.autoconfigure.powerjob.PowerJobProperties",
      "defaultValue": 64
    },
    {
      "name": "tj.powerjob.worker.health-report-interval",
      "type": "java.lang.Integer",
      "description": "Worker健康上报间隔（秒）",
      "sourceType": "com.example.tj_project_apicommon.autoconfigure.powerjob.PowerJobProperties",
      "defaultValue": 10
    },
    {
      "name": "tj.powerjob.worker.enable-test-mode",
      "type": "java.lang.Boolean",
      "description": "是否开启测试模式（开发环境可开启，跳过Server连接校验）",
      "sourceType": "com.example.tj_project_apicommon.autoconfigure.powerjob.PowerJobProperties",
      "defaultValue": false
    }
