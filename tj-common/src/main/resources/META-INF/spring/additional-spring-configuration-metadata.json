      "defaultValue": true
    },
    {
      "name": "tj.powerjob.worker.app-name",
      "type": "java.lang.String",
      "description": "应用名称，需在PowerJob控制台提前注册，用于分组隔离",
      "sourceType": "com.example.tj_project_apicommon.autoconfigure.powerjob.PowerJobProperties"
    },
    {
      "name": "tj.powerjob.worker.server-address",
      "type": "java.lang.String",
      "description": "PowerJob Server地址，多个地址用逗号分隔，如127.0.0.1:7700,127.0.0.1:7701",
      "sourceType": "com.example.tj_project_apicommon.autoconfigure.powerjob.PowerJobProperties"
    },
    {
      "name": "tj.powerjob.worker.port",
      "type": "java.lang.Integer",
      "description": "Worker监听端口，默认27777",
      "sourceType": "com.example.tj_project_apicommon.autoconfigure.powerjob.PowerJobProperties",
      "defaultValue": 27777
    },
    {
      "name": "tj.powerjob.worker.protocol",
      "type": "java.lang.String",
      "description": "通讯协议，支持 HTTP 和 AKKA，推荐 HTTP",
      "sourceType": "com.example.tj_project_apicommon.autoconfigure.powerjob.PowerJobProperties",
      "defaultValue": "HTTP"
    },
    {
      "name": "tj.powerjob.worker.store-strategy",
      "type": "java.lang.String",
      "description": "本地存储策略，disk(磁盘) 或 memory(内存)",
